{"cues": [["लोक मला काहीही म्हणोत,", 0.24, 1.6300000000000001], ["पण मी त्याला विसरणार नाही!", 2.32, 3.91], ["कुणाला?", 5.08, 5.46], ["त्याचं उत्तर तुकाराम गाथेच्या सातव्या अभंगात आहे.", 6.15, 9.01], ["हा आजचा अभंग.", 10.33, 11.5], ["आधी याचा अर्थ समजून घेऊ.", 12.38, 13.47], ["तुकोबा म्हणतात,", 15.35, 16.01], ["लोकांनी मला दूर लोटावं,", 16.8, 18.17], ["मला कितीही नावं ठेवावीत,", 19.14, 20.53], ["पण या वनमाळी हरीला मी कधीच विसरणार नाही.", 21.330000000000002, 24.28], ["लोकांच्या रीतीभाती सोडून मी उदास झालो आहे.", 25.73, 28.03], ["आता मला जगण्याची भीती नाही,", 28.86, 30.57], ["आणि कसलीच आस नाही.", 31.03, 32.3], ["या लोकांचं बोलणं मी ऐकतच नाही.", 33.49, 35.4], ["तुकोबा म्हणतात,", 36.65, 37.31], ["मी हरीच्या रंगात रंगून गेलो आहे.", 37.910000000000004, 39.910000000000004], ["तर आजचं सांगणं इतकंच.", 40.95, 42.82], ["जग काहीही म्हणो,", 43.57, 44.51], ["ज्याचं मन हरीत रमलं,", 45.480000000000004, 46.87], ["त्याला कुणाची भीती नाही.", 47.47, 48.71], ["आता हा अनोखा अभंग पुन्हा ऐका,", 50.24, 52.22], ["आणि आत्ता समजलेला अर्थ मनात ठेवून एकाग्र व्हा.", 52.86, 55.78], ["वाळो जन मज म्हणोत शिंदळी।", 57.300000000000004, 59.54], ["परि हा वनमाळी न विसंबें॥", 60.33, 62.13], ["सांडूनि लौकिक जालियें उदास।", 62.96, 65.05], ["नाहीं भय आस जीवित्वाची॥", 65.68, 67.83], ["नाइकें वचन बोलतां या लोकां।", 68.61, 70.60000000000001], ["म्हणे जालों तुका हरिरता॥", 71.23, 73.27], ["असेच अभंग रोज समजून घ्यायचे असतील,", 74.15, 77.28], ["तर भक्ती अर्थ चॅनेल फॉलो करा.", 78.16, 80.06], ["राम कृष्ण हरी!", 81.28, 82.07000000000001]], "para_end": [3, 5, 9, 12, 15, 19, 27, 30]}