{"cues": [["क्षणभरही त्याच्याशिवाय करमत नाही!", 0.16, 2.49], ["कुणाशिवाय?", 3.45, 4.03], ["त्याचं उत्तर तुकाराम गाथेच्या आठव्या अभंगात आहे.", 4.66, 7.57], ["हा आजचा अभंग.", 8.55, 9.3], ["आधी याचा अर्थ समजून घेऊ.", 10.08, 11.33], ["तुकोबा इथे प्रेमात बुडलेल्या मनाच्या भावनेने बोलतात.", 12.370000000000001, 15.35], ["ते म्हणतात,", 16.11, 16.56], ["आधीच्या धन्याकडून,", 17.13, 18.21], ["म्हणजे या जगाकडून,", 18.7, 20.1], ["माझं मन कधीच पूर्ण तृप्त झालं नाही.", 20.29, 22.54], ["म्हणून आता माझं मन देवाकडे वळलं आहे.", 23.26, 25.51], ["रात्रंदिवस तो मला जवळ हवा.", 26.23, 28.09], ["त्याच्याशिवाय एक क्षणही,", 28.59, 30.2], ["एक घटकाही करमत नाही.", 30.44, 31.93], ["आता माझी काळजी करणं,", 32.81, 34.12], ["माझ्याबद्दल बोलणं सोडा.", 34.4, 35.83], ["तुकोबा म्हणतात,", 36.480000000000004, 37.2], ["मी अनंताच्या प्रेमात रंगून गेलो आहे.", 37.57, 39.53], ["तर आजचं सांगणं इतकंच.", 40.68, 42.47], ["जगाकडून मन भरत नाही,", 43.08, 44.57], ["पण देवाच्या प्रेमात मन पूर्ण तृप्त होतं.", 45.18, 48.63], ["आता हा अनोखा अभंग पुन्हा ऐका,", 49.58, 51.92], ["आणि आत्ता समजलेला अर्थ मनात ठेवून एकाग्र व्हा.", 52.42, 55.660000000000004], ["आधिल्या भ्रतारें काम नव्हे पुरा।", 56.99, 59.34], ["म्हणोनि व्यभिचारा टेकलियें॥", 59.95, 61.800000000000004], ["रात्रंदिस मज पाहिजे जवळी।", 62.64, 65.03], ["क्षण त्यानिराळी न गमे घडी॥", 65.59, 67.75], ["नाम गोष्टी माझी सोय सांडा आतां।", 68.28, 71.3], ["रातलें अनंता तुका म्हणे॥", 71.98, 73.91], ["असेच अभंग रोज समजून घ्यायचे असतील,", 75.52, 77.96000000000001], ["तर भक्ती अर्थ चॅनेल फॉलो करा.", 78.3, 80.08], ["राम कृष्ण हरी!", 80.74, 81.58]], "para_end": [2, 4, 10, 13, 17, 20, 28, 31]}